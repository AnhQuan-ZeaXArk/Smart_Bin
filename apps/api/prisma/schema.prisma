generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  SUPERVISOR
  WORKER
}

enum StationStatus {
  ONLINE
  WARNING
  OFFLINE
  MAINTENANCE
}

enum BinStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum CollectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AlertType {
  NEARLY_FULL
  CRITICAL
  DEVICE_OFFLINE
  SENSOR_ABNORMAL
  COMMISSIONING_REQUIRED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DeviceType {
  RASPBERRY_PI
  ULTRASONIC_SENSOR
  CAMERA
  MQTT
}

enum DeviceStatusEnum {
  ONLINE
  WARNING
  OFFLINE
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String?
  passwordHash String
  roleId       String
  isActive     Boolean  @default(true)
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DeviceStatus {
  id              String           @id @default(cuid())
  deviceId        String           @unique
  deviceName      String
  deviceType      DeviceType
  status          DeviceStatusEnum @default(OFFLINE)
  lastSeen        DateTime         @default(now())
  lastHeartbeat   DateTime?
  firmwareVersion String?
  ipAddress       String?
  uptime          Int?
  metadata        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([deviceType, status])
  @@index([lastSeen])
}

model Station {
  id                 String                      @id @default(cuid())
  code               String                      @unique
  name               String
  status             StationStatus               @default(OFFLINE)
  isActive           Boolean                     @default(true)
  location           String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  bins               Bin[]
  watermarks         StationWatermark[]
  idempotencyLedgers TelemetryIdempotencyLedger[]
}

model Bin {
  id                String             @id @default(cuid())
  stationId         String?
  binCode           String
  name              String
  location          String
  latitude          Float?
  longitude         Float?
  capacity          Int
  currentFillLevel  Int?               @default(0)
  status            BinStatus          @default(OFFLINE)
  isActive          Boolean            @default(true)
  installed         Boolean            @default(true)
  lastSeen          DateTime?
  station           Station?           @relation(fields: [stationId], references: [id], onDelete: Restrict)
  sensorReadings    SensorReading[]
  collectionRecords CollectionRecord[]
  alerts            Alert[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([stationId, binCode])
  @@index([stationId, isActive])
  @@index([isActive, status])
  @@index([binCode])
}

model SensorReading {
  id        String   @id @default(cuid())
  binId     String
  distance  Float
  fillLevel Int
  isLate    Boolean  @default(false)
  timestamp DateTime @default(now())
  bin       Bin      @relation(fields: [binId], references: [id])
  createdAt DateTime @default(now())

  @@index([binId, timestamp])
  @@index([isLate])
}

model StationWatermark {
  id              String   @id @default(cuid())
  stationCode     String
  binCode         String
  bootCount       BigInt   @default(0)
  bootId          String
  lastSampleSeq   Int      @default(0)
  lastPayloadHash String
  updatedAt       DateTime @default(now()) @updatedAt
  station         Station? @relation(fields: [stationCode], references: [code])

  @@unique([stationCode, binCode])
  @@index([stationCode, updatedAt])
}

model TelemetryIdempotencyLedger {
  id          String   @id @default(cuid())
  stationCode String
  bootId      String
  sampleSeq   Int
  payloadHash String
  receivedAt  DateTime @default(now())
  station     Station? @relation(fields: [stationCode], references: [code])

  @@unique([stationCode, bootId, sampleSeq])
  @@index([receivedAt])
}

model MigrationProvenance {
  id           Int       @id @default(autoincrement())
  phase        String
  action       String
  target       String
  status       String    @default("APPLIED")
  appliedAt    DateTime  @default(now())
  rolledBackAt DateTime?
  notes        String?

  @@map("_migration_provenance")
}

model CollectionRecord {
  id              String           @id @default(cuid())
  binId           String
  collectedBy     String?
  collectedAt     DateTime         @default(now())
  fillLevelBefore Int
  fillLevelAfter  Int?
  status          CollectionStatus @default(PENDING)
  notes           String?
  bin             Bin              @relation(fields: [binId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([binId, collectedAt])
}

model Alert {
  id         String        @id @default(cuid())
  binId      String?
  type       AlertType
  severity   AlertSeverity
  message    String
  isResolved Boolean       @default(false)
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
  bin        Bin?          @relation(fields: [binId], references: [id])

  @@index([isResolved, createdAt])
}

model SystemSetting {
  id                String   @id @default("default")
  warningThreshold  Int      @default(50) @map("warning_threshold")
  nearFullThreshold Int      @default(70) @map("near_full_threshold")
  fullThreshold     Int      @default(90) @map("full_threshold")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
