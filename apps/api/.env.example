NODE_ENV=development
PORT=4000
API_PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET="local-development-secret-please-change"
JWT_EXPIRES_IN=1d
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smartbin-backend
SIM_BIN_CODE=ORGANIC
SEED_ADMIN_PASSWORD=change-me-admin
SEED_SUPERVISOR_PASSWORD=change-me-supervisor
SEED_WORKER_PASSWORD=change-me-worker

