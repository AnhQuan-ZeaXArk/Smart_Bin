{
  "name": "@smartbin/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=./.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:validate": "node scripts/prisma-validate.js",
    "db:validate:sqlite": "prisma validate --schema=prisma/schema.sqlite.prisma",
    "db:validate:postgres": "prisma validate --schema=prisma/schema.prisma",
    "db:generate": "node scripts/prisma-generate.js",
    "db:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "node --env-file=./.env ../../node_modules/prisma/build/index.js migrate dev --name init",
    "db:seed": "node --env-file=./.env ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "mqtt:simulator": "node --env-file=./.env ../../node_modules/tsx/dist/cli.mjs src/integrations/mqtt/simulator.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.15.2",
    "socket.io": "^4.8.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
