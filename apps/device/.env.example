# Cấu hình SmartBin Raspberry Pi 5 Agent
# Sao chép file này thành .env: cp .env.example .env
# KHÔNG đưa file .env chứa token thật vào Git repository

# URL Backend SmartBin API (Render hoặc Local)
SERVER_URL=https://smartbin-api-e08b.onrender.com

# Mã định danh thiết bị phần cứng
DEVICE_ID=raspberry-pi-5

# Token xác thực thiết bị (khớp với DEVICE_INGEST_TOKEN cấu hình trên Render)
DEVICE_INGEST_TOKEN=your-device-ingest-token-here

# Chu kỳ gửi telemetry (giây: 5 đến 10)
TELEMETRY_INTERVAL=5
