# Cấu hình SmartBin Raspberry Pi 5 Agent v2.0
# Sao chép file này thành .env: cp .env.example .env
# KHÔNG đưa file .env chứa token thật vào Git repository

# 1. Kết nối Backend SmartBin API (Render hoặc Local)
SERVER_URL=https://smartbin-api-e08b.onrender.com
DEVICE_ID=raspberry-pi-5
DEVICE_INGEST_TOKEN=ThayBangTokenIngestCuaBan
TELEMETRY_INTERVAL=5

# 2. Cấu hình IPC Bridge nhận kết quả AI YOLO (từ ~/Desktop/yolo_camera.py)
SMARTBIN_YOLO_STATE_FILE=/tmp/smartbin_yolo_state.json

# 3. Cấu hình USB Serial ESP32 (Đọc cảm biến siêu âm 3 ngăn)
ESP32_PORT=/dev/ttyUSB0
ESP32_BAUD_RATE=115200
SENSOR_STALE_TIMEOUT_SEC=15.0

# 4. Hiệu chuẩn mức đầy thùng rác (cm)
# Khoảng cách từ cảm biến tới đáy khi thùng rỗng hoàn toàn:
EMPTY_DISTANCE_CM=50.0
# Khoảng cách từ cảm biến tới bề mặt rác khi thùng đầy tới miệng:
FULL_DISTANCE_CM=5.0
