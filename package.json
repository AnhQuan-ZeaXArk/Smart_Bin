{
  "name": "smart-bin-management-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @smartbin/api\" \"npm run dev --workspace @smartbin/web\"",
    "dev:api": "npm run dev --workspace @smartbin/api",
    "dev:web": "npm run dev --workspace @smartbin/web",
    "dev:mobile": "npm run start --workspace @smartbin/mobile",
    "lint:mobile": "npm run lint --workspace @smartbin/mobile",
    "build": "npm run build --workspace @smartbin/api && npm run build --workspace @smartbin/web",
    "start": "npm run start --workspace @smartbin/api",
    "start:api": "npm run start --workspace @smartbin/api",
    "lint": "npm run lint --workspace @smartbin/api && npm run lint --workspace @smartbin/web",
    "db:validate": "npm run db:validate --workspace @smartbin/api",
    "db:generate": "npm run db:generate --workspace @smartbin/api",
    "db:migrate": "npm run db:migrate --workspace @smartbin/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @smartbin/api",
    "migration:verify": "npm run migration:verify --workspace @smartbin/api",
    "db:seed": "npm run db:seed --workspace @smartbin/api"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}